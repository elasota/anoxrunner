include "rkit/render/bindings.rki"

struct S_InterfacePixelConstants
{
	float4 InterformTransform
	uint PrevFrame_NextFrame
	uint NumVerts
	float FrameInterpolator
}


PipelineLayout PL_Interface
{
	TextureHeapVisibility = Pixel
	SamplerHeapVisibility = Pixel

	ConstantBufferBindings =
	{
		PixelConstants =
		{
			Visibility = Pixel
		}
	}
}

GraphicsPipeline GP_InterfaceSimple
{
	InputLayout = IL_InterfaceSimple
	PipelineLayout = PL_Interface

	DescriptorHeaps =
	{
		Texture2DHeap = Texture2D<float4>
	}

	ConstantBuffers =
	{
		PixelConstants = S_InterfacePixelConstants
	}

	VertexShader =
	{
		Source = "ui_vs.rkc"
		EntryPoint = "VertexMain"
	}

	PixelShader =
	{
		Source = "ui_ps.rkc"
		EntryPoint = "PixelMain"
	}

	PrimitiveTopology = TriangleList

	RenderTargets =
	{
		Color =
		{
			Access = ReadWrite
			SrcBlend = One
			DstBlend = InvSrcAlpha
		}
	}

	ExecuteInPass = RP_Interface
}
